def generate_flake_tile_rgb(size, cells, fraction, tilt, seed):
    """
    Pure-numpy, perfectly tileable "metal flake" tangent-space normal map.
    A jittered grid (with wrap-around) gives Voronoi-like cells; `fraction` of them are tilted
    facets (random direction, up to `tilt`), the rest stay flat. Returns float32 (size, size, 3)
    with RGB = normal * 0.5 + 0.5.
    """
    import numpy as np
    rng = np.random.default_rng(seed)

    jitter = rng.random((cells, cells, 2))
    raised = rng.random((cells, cells)) < fraction
    ang = rng.random((cells, cells)) * (2.0 * np.pi)
    mag = (0.35 + 0.65 * rng.random((cells, cells))) * tilt
    tx = np.where(raised, np.cos(ang) * mag, 0.0)
    ty = np.where(raised, np.sin(ang) * mag, 0.0)

    coords = (np.arange(size) + 0.5) * (cells / float(size))
    px, py = np.meshgrid(coords, coords)            # arrays are [row = y, col = x]
    ci = np.floor(px).astype(np.int32)
    cj = np.floor(py).astype(np.int32)

    best = np.full(px.shape, np.inf)
    bi = np.zeros(px.shape, dtype=np.int32)
    bj = np.zeros(px.shape, dtype=np.int32)
    for dj in (-1, 0, 1):
        for di in (-1, 0, 1):
            ni = (ci + di) % cells
            nj = (cj + dj) % cells
            fx = (ci + di) + jitter[nj, ni, 0]
            fy = (cj + dj) + jitter[nj, ni, 1]
            d = (px - fx) ** 2 + (py - fy) ** 2
            closer = d < best
            best = np.where(closer, d, best)
            bi = np.where(closer, ni, bi)
            bj = np.where(closer, nj, bj)

    nx = tx[bj, bi]
    ny = ty[bj, bi]
    nz = np.ones_like(nx)
    inv = 1.0 / np.sqrt(nx * nx + ny * ny + nz * nz)
    rgb = np.stack([nx * inv, ny * inv, nz * inv], axis=-1) * 0.5 + 0.5
    return rgb.astype(np.float32)

def create_flake_detail_tile(save_dir):
    """Generates the flake tile once and saves it as an 8-bit Non-Color PNG. Returns its path (or None)."""
    try:
        import numpy as np
        size = int(FLAKE_TILE_SIZE)
        rgb = generate_flake_tile_rgb(size, int(FLAKE_CELLS_PER_TILE), FLAKE_FRACTION, FLAKE_TILT, FLAKE_SEED)
        rgba = np.ones((size, size, 4), dtype=np.float32)
        rgba[..., :3] = rgb

        tmp_name = "FlakeDetail_TMP"
        if tmp_name in bpy.data.images:
            bpy.data.images.remove(bpy.data.images[tmp_name])

        img = bpy.data.images.new(tmp_name, width=size, height=size, alpha=False, float_buffer=False)
        img.colorspace_settings.name = 'Non-Color'
        img.pixels.foreach_set(rgba.ravel())

        path = os.path.join(save_dir, f"FlakeDetail_Normal_{size}.png")
        img.filepath_raw = path
        img.file_format = 'PNG'
        img.save()
        bpy.data.images.remove(img)
        print(f"Flake detail tile written: {path}")
        return path
    except Exception as e:
        print(f"Flake detail tile could not be created: {e}")
        return None

def add_flake_detail_normal(nodes, links, bsdf, uv_node, repeat, tile_path, base_normal_color_out, base_normal_map_node):
    """
    Layers the repeating flake tile over the baked macro normal (detail blending in tangent space):
        color = macro_color + detail_color - (0.5, 0.5, 1.0)  -> Normal Map node (which re-normalises)
    NOTE: this uses Vector Math nodes, so it is a Blender-side look only; the glTF exporter will not
    carry the combine. For the website load FlakeDetail_Normal_*.png as a separate detail normal.
    """
    mapping = nodes.new('ShaderNodeMapping')
    mapping.location = (-800, -500)
    mapping.inputs['Scale'].default_value = (repeat, repeat, 1.0)
    links.new(uv_node.outputs['UV'], mapping.inputs['Vector'])

    img = bpy.data.images.load(tile_path, check_existing=True)
    try:
        img.reload()
    except Exception:
        pass
    img.colorspace_settings.name = 'Non-Color'

    det = nodes.new('ShaderNodeTexImage')
    det.image = img
    det.extension = 'REPEAT'
    det.interpolation = 'Linear'
    det.label = "Flake Detail Normal"
    det.location = (-500, -500)
    links.new(mapping.outputs['Vector'], det.inputs['Vector'])

    combined = det.outputs['Color']
    if base_normal_color_out is not None:
        add = nodes.new('ShaderNodeVectorMath')
        add.operation = 'ADD'
        add.location = (-250, -500)
        links.new(base_normal_color_out, add.inputs[0])
        links.new(det.outputs['Color'], add.inputs[1])

        sub = nodes.new('ShaderNodeVectorMath')
        sub.operation = 'SUBTRACT'
        sub.location = (-80, -500)
        links.new(add.outputs['Vector'], sub.inputs[0])
        sub.inputs[1].default_value = (0.5, 0.5, 1.0)
        combined = sub.outputs['Vector']

    nm = nodes.new('ShaderNodeNormalMap')
    nm.space = 'TANGENT'
    nm.uv_map = "Bake_UV"
    nm.location = (100, -500)
    links.new(combined, nm.inputs['Color'])
    links.new(nm.outputs['Normal'], bsdf.inputs['Normal'])

    if base_normal_map_node is not None:
        try:
            nodes.remove(base_normal_map_node)
        except Exception:
            pass

